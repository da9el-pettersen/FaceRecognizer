# Kopier til .env på HAOS-maskinen og fyll ut. Ikke sjekk inn .env.

# MQTT (Mosquitto)
Mqtt__Host=core-mosquitto
Mqtt__Port=1883
Mqtt__Username=
Mqtt__Password=

# Reolink-kamera (fast IP anbefales: DHCP-reservasjon for MAC EC:71:DB:58:7C:46)
Camera__BaseUrl=https://kamera.local
Camera__Username=
Camera__Password=
# SHA-256 av kameraets sertifikat. Hent med PowerShell:
#   $c=[Net.Sockets.TcpClient]::new('kamera.local',443);$s=[Net.Security.SslStream]::new($c.GetStream(),$false,{$true});$s.AuthenticateAsClient('x');[Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($s.RemoteCertificate.GetRawCertData()))
Camera__CertificateSha256=

# Gjenkjenning
Face__ReferenceFolder=/data/faces
Face__Threshold=0.98
