# Kopier til .env (ikke i Git). Ingen ekte hemmeligheter her.
# Generer token f.eks.: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]])
DEEPFACE_AUTH_TOKEN=

# Motor: DeepFace eller FaceAiSharp
FACE_RECOGNITION_PROVIDER=DeepFace
DEEPFACE_MODEL=SFace
# Minste cosinus-likhet. Kalibrer med egne bilder.
DEEPFACE_THRESHOLD=0.5
FACEAISHARP_THRESHOLD=0.98

# MQTT. Standard er test-brokeren (--profile dev). Sett verdier for ekte Mosquitto.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

CAMERA_NAME=inngang
CAMERA_BASE_URL=https://kamera.local
CAMERA_USERNAME=
CAMERA_PASSWORD=
# SHA-256 av kameraets sertifikat (hex). Uten dette avvises alle kamerakall.
CAMERA_CERT_SHA256=

# Delte hemmeligheter mellom tjenestene (egne verdier for hver).
DATABASE_TOKEN=
RECOGNITION_API_TOKEN=
ADMIN_TOKEN=
